{
  "name": "inbrowser",
  "private": true,
  "version": "0.4.6",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "The whole AI stack in one browser tab. Local models, twelve language runtimes, agents and skills. No account, no API key, no server.",
  "homepage": "https://inbrowser.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/Choy0X/Inbrowser.git"
  },
  "keywords": [
    "ai",
    "chat",
    "llm",
    "webgpu",
    "webllm",
    "local-ai",
    "offline",
    "privacy",
    "pwa",
    "client-side",
    "browser",
    "agents",
    "serverless"
  ],
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('node_modules/.monaco', { recursive: true, force: true })\"",
    "dev": "node --watch server/src/index.ts",
    "build": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit && vite build && esbuild server/src/index.ts --bundle --platform=node --format=cjs --target=node22 --external:vite --external:@fastify/middie --outfile=server/dist/relay.cjs --log-level=error",
    "start": "node server/dist/relay.cjs",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=cjs --target=node22 --external:vite --external:@fastify/middie --outfile=server/dist/relay.cjs --log-level=error",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/middie": "9.3.4",
    "@fastify/static": "10.1.3",
    "@lexical/react": "^0.50.0",
    "@lexical/utils": "^0.50.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "@monaco-editor/react": "^4.7.0",
    "@php-wasm/web": "^3.1.54",
    "@ruby/4.0-wasm-wasi": "^2.10.1",
    "@ruby/wasm-wasi": "^2.10.1",
    "@tanstack/react-virtual": "^3.14.10",
    "@zenfs/dom": "^1.2.14",
    "browsercc": "^0.1.1",
    "chart.js": "^4.5.1",
    "docx": "^9.7.1",
    "esbuild-wasm": "^0.28.2",
    "fastify": "5.12.5",
    "fflate": "^0.8.3",
    "js-yaml": "^5.4.1",
    "katex": "^0.18.7",
    "lexical": "^0.50.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.2",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.0.0",
    "monaco-editor": "^0.56.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pyodide": "^314.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.6",
    "react-syntax-highlighter": "^15.6.6",
    "redis": "5.11.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "scittle": "0.8.33",
    "sql.js": "^1.14.2",
    "unified": "^11.0.5",
    "wasi-sh": "^0.11.0",
    "wasmoon": "^1.16.0",
    "webr": "^0.6.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.27",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
